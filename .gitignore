__pycache__/
*.pyc
.DS_Store
.venv/
.pytest_cache/

# Runtime CMS state (size history). Ships the empty sync_facts.yaml starter only.
plugins/crucible/skills/cms/state/size_history.json

# Runtime loop-harness state. loop_common creates state/ on import — so merely running the
# tests drops a run.json/cost-log.jsonl here, carrying local temp paths. Nothing ships from it.
plugins/crucible/skills/loop-harness/state/

# eval baseline reports (frozen on demand; keep the dir, not the run artifacts)
evals/baselines/*.json

# Raw per-lens audit output. Only the synthesized report in docs/audits/ is versioned —
# repeated audits would otherwise accrete MBs of committed agent dumps.
docs/audits/.raw/

# Secrets. Never tracked. This repo is public and its CI docs tell contributors to hold an
# ANTHROPIC_API_KEY, so an untracked-but-unignored .env is one `git add -A` from publication.
.env
.env.*
!.env.example
